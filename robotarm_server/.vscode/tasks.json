{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Build (Cross-compile)",
            "type": "shell",
            "command": "cargo",
            "args": [
                "zigbuild",
                "--target",
                "aarch64-unknown-linux-gnu",
                "--release"
            ],
            "group": "build",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "2. Deploy (SCP)",
            "type": "shell",
            "command": "scp",
            "args": [
                "target/aarch64-unknown-linux-gnu/release/robotarm_server",
                "ubuntu@pitest:/home/ubuntu/robotarm/robotarm_server"
            ],
            "dependsOn": ["1. Build (Cross-compile)"]
        },
        {
            "label": "3. Run on Pi",
            "type": "shell",
            "command": "ssh",
            "args": [
                "-t",
                "ubuntu@pitest",
                "chmod +x /home/ubuntu/robotarm/robotarm_server && /home/ubuntu/robotarm/robotarm_server"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            // "label": "Build, Deploy & Run",
            // "label": "custom_run2",
            "label": "custom_run",
            "dependsOrder": "sequence",
            "dependsOn": [
                "2. Deploy (SCP)",
                "3. Run on Pi"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
